# PostgreSQL connection used in production and by Prisma migrations.
# For Supabase use:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DATABASE_URL=
# Private Supabase Storage used by admin media uploads.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=rpm-media
FILE_DATABASE_PATH=
# A random 32+ character secret used to sign admin sessions.
AUTH_SECRET=
# Single-admin credentials. Generate the hash with: pnpm auth:hash -- "your password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Canonical public origin, without a trailing slash.
# Local development origin. Production must use https://rpmrent.ru.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, enables analytics only when populated.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Optional provider script URL supplied by your calltracking service.
NEXT_PUBLIC_CALLTRACKING_SCRIPT_URL=
# Optional confirmed customer contacts.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_ADDRESS=
# Optional confirmed contact details and map embed URL.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_HOURS=
NEXT_PUBLIC_MAP_EMBED_URL=
# Optional CRM webhook. Booking remains saved even when the webhook fails.
CRM_WEBHOOK_URL=
# Server-only Telegram bot integration.
TELEGRAM_BOT_TOKEN=
# Legacy setting, no longer used for lead or booking alerts. Both go to all activated bot operators.
TELEGRAM_ALERT_CHAT_ID=
# Initial administrators, comma-separated usernames without @. They become permanently bound to Telegram IDs after /start.
TELEGRAM_BOOTSTRAP_ADMINS=
# Generate a random secret and use the same value when calling Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# Optional server-only Avito OAuth2 credentials for marketplace monitoring.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Per-request timeout in milliseconds. Defaults to 10000.
AVITO_TIMEOUT_MS=10000

# VK Ads pixel supplied by the owner. Clear ID to disable; rebuild after changes.
NEXT_PUBLIC_VK_PIXEL_ID=
NEXT_PUBLIC_VK_LEAD_GOAL=lead
